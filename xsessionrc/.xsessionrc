#@IgnoreInspection BashAddShebang
# In MATE .profile doesn't run at user login. This is workaround for this issue.

# ~/.profile: executed by the command interpreter for login shells.
# This file is not read by bash(1), if ~/.bash_profile or ~/.bash_login
# exists.
# see /usr/share/doc/bash/examples/startup-files for examples.
# the files are located in the bash-doc package.

# the default umask is set in /etc/profile; for setting the umask
# for ssh logins, install and configure the libpam-umask package.
#umask 022

export LC_TIME=ru_RU.utf8

# if running bash
if [ -n "$BASH_VERSION" ]; then
	# include .bashrc if it exists
	if [ -f "$HOME/.bashrc" ]; then
	. "$HOME/.bashrc"
	fi
fi

# set PATH so it includes user's private bin if it exists
if [ -d "$HOME/.local/bin" ] ; then
	PATH="$HOME/.local/bin:$PATH"
fi

# Ждем появления базового каталога (до 10 секунд)
for i in $(seq 1 100); do
    [ -d "$XDG_RUNTIME_DIR" ] && break
    sleep 0.1
done

# Создаем подкаталог pulse, если его еще нет
if [ -d "$XDG_RUNTIME_DIR" ] && [ ! -d "$XDG_RUNTIME_DIR/pulse" ]; then
    mkdir -p "$XDG_RUNTIME_DIR/pulse"
    chmod 700 "$XDG_RUNTIME_DIR/pulse"
fi

# Запускаем PulseAudio, если он еще не запущен
if ! pgrep -x pulseaudio >/dev/null; then
    /usr/bin/start-pulseaudio-x11
fi
